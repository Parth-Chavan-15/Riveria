MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/riveria
JWT_SECRET=replace-with-a-random-32-character-minimum-secret
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:8080
# Set these only while running npm run seed:admin --prefix server; do not deploy them.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
