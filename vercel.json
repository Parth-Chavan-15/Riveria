{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(assets/.*|covers/.*|audio/.*|favicon.ico|index.html)",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client",
        "path": "/index.html"
      }
    }
  ]
}
